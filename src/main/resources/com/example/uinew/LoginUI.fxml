      <StackPane layoutX="2.0" layoutY="28.0" prefHeight="734.0" prefWidth="1199.0" style="-fx-background-image: url('/e19429e326bd7582329d3a7502b5953c.jpg'); -fx-background-color: rgba(0,0,0,0.3); -fx-background-size: cover; -fx-background-position: center;" AnchorPane.bottomAnchor="2.6666666666666288" AnchorPane.leftAnchor="2.0" AnchorPane.rightAnchor="2.6666666666667425" AnchorPane.topAnchor="28.0">
         <children>
