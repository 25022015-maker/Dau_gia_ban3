<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="590.0" prefWidth="749.0" spacing="0"
      style="-fx-background-color: #1a1a2e;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.project.UI.Controller.ProductListController">

    <!-- Header + search -->
    <HBox prefHeight="60.0" spacing="12.0" alignment="CENTER_LEFT"
          style="-fx-background-color: #16213e; -fx-border-color: #2d2d4e; -fx-border-width: 0 0 1 0;">
        <padding><Insets left="24.0" right="24.0"/></padding>
        <Label text="🛍️  Sản phẩm đang đấu giá"
               style="-fx-text-fill: #f8f0ff; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="🔍 Tìm kiếm..."
                   prefWidth="200.0" prefHeight="34.0"
                   onKeyTyped="#handleSearch"
                   style="-fx-background-color: #2d2d4e; -fx-text-fill: #f8f0ff;
                        -fx-background-radius: 8; -fx-padding: 6 12;"/>
    </HBox>

    <!-- Sort bar -->
    <HBox spacing="8.0" style="-fx-background-color: #16213e; -fx-border-color: #2d2d4e; -fx-border-width: 0 0 1 0;">
        <padding><Insets left="24.0" right="24.0" top="8.0" bottom="8.0"/></padding>
        <Label text="Sắp xếp:" style="-fx-text-fill: #7f8c9a; -fx-font-size: 13px;"/>
        <Button fx:id="btnSortPrice" text="Giá tăng dần ↑" onAction="#sortByPrice"
                style="-fx-background-color: #6c3483; -fx-text-fill: white;
                     -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 4 12;"/>
        <Button text="Giá giảm dần ↓" onAction="#sortByPriceDesc"
                style="-fx-background-color: #2d1b4e; -fx-text-fill: #c39bd3;
                     -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 4 12;"/>
        <Button text="Sắp kết thúc ⏱" onAction="#sortByTime"
                style="-fx-background-color: #2d1b4e; -fx-text-fill: #c39bd3;
                     -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 4 12;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblCount" text="0 sản phẩm"
               style="-fx-text-fill: #7f8c9a; -fx-font-size: 13px;"/>
    </HBox>

    <!-- Product list -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: #1a1a2e;">
        <VBox fx:id="productList" spacing="8.0">
            <padding><Insets top="16.0" left="16.0" right="16.0" bottom="16.0"/></padding>
        </VBox>
    </ScrollPane>

</VBox>
