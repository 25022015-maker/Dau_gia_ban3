<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="590.0" prefWidth="749.0" spacing="0"
      style="-fx-background-color: #1a1a2e;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.uinew.Controller.ManagementController">

    <!-- Header -->
    <HBox prefHeight="60.0" spacing="12.0" alignment="CENTER_LEFT"
          style="-fx-background-color: #16213e; -fx-border-color: #2d2d4e; -fx-border-width: 0 0 1 0;">
        <padding><Insets left="24.0" right="24.0"/></padding>
        <Label text="⚙️  Quản lý phiên đấu giá"
               style="-fx-text-fill: #f8f0ff; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="➕ Tạo phiên mới"
                onAction="#showCreateForm"
                style="-fx-background-color: #6c3483; -fx-text-fill: white;
                     -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 16;"/>
    </HBox>

    <!-- Create form (ẩn mặc định) -->
    <VBox fx:id="createForm" spacing="12.0"
          style="-fx-background-color: #16213e; -fx-border-color: #6c3483;
                -fx-border-width: 0 0 2 0;"
          visible="false" managed="false">
        <padding><Insets top="16.0" left="24.0" right="24.0" bottom="16.0"/></padding>
        <Label text="Tạo phiên đấu giá mới"
               style="-fx-text-fill: #f8f0ff; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        <HBox spacing="12.0">
            <TextField fx:id="txtItemName" promptText="Tên sản phẩm"
                       prefWidth="200.0" prefHeight="36.0"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: #f8f0ff;
                           -fx-border-color: #2d2d4e; -fx-border-radius: 6; -fx-background-radius: 6;"/>
            <TextField fx:id="txtStartPrice" promptText="Giá khởi điểm (₫)"
                       prefWidth="160.0" prefHeight="36.0"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: #f8f0ff;
                           -fx-border-color: #2d2d4e; -fx-border-radius: 6; -fx-background-radius: 6;"/>
            <TextField fx:id="txtDuration" promptText="Thời gian (giờ)"
                       prefWidth="130.0" prefHeight="36.0"
                       style="-fx-background-color: #1a1a2e; -fx-text-fill: #f8f0ff;
                           -fx-border-color: #2d2d4e; -fx-border-radius: 6; -fx-background-radius: 6;"/>
            <Button text="Tạo" onAction="#handleCreate"
                    prefHeight="36.0" prefWidth="70.0"
                    style="-fx-background-color: #6c3483; -fx-text-fill: white;
                        -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button text="Hủy" onAction="#hideCreateForm"
                    prefHeight="36.0" prefWidth="60.0"
                    style="-fx-background-color: #2d1b4e; -fx-text-fill: #c39bd3;
                        -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>
        <Label fx:id="lblCreateMsg" text="" visible="false" managed="false"
               style="-fx-font-size: 13px;"/>
    </VBox>

    <!-- Stats bar -->
    <HBox spacing="1.0" style="-fx-background-color: #16213e;">
        <VBox alignment="CENTER" prefWidth="160.0" prefHeight="60.0"
              style="-fx-background-color: #16213e; -fx-padding: 10;">
            <Label fx:id="statTotal" text="0"
                   style="-fx-text-fill: #f1c40f; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Tổng phiên" style="-fx-text-fill: #7f8c9a; -fx-font-size: 11px;"/>
        </VBox>
        <VBox alignment="CENTER" prefWidth="160.0" prefHeight="60.0"
              style="-fx-background-color: #16213e; -fx-padding: 10;">
            <Label fx:id="statRunning" text="0"
                   style="-fx-text-fill: #2ecc71; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Đang diễn ra" style="-fx-text-fill: #7f8c9a; -fx-font-size: 11px;"/>
        </VBox>
        <VBox alignment="CENTER" prefWidth="160.0" prefHeight="60.0"
              style="-fx-background-color: #16213e; -fx-padding: 10;">
            <Label fx:id="statFinished" text="0"
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Đã kết thúc" style="-fx-text-fill: #7f8c9a; -fx-font-size: 11px;"/>
        </VBox>
    </HBox>

    <!-- Auction list -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: #1a1a2e;">
        <VBox fx:id="auctionList" spacing="8.0">
            <padding><Insets top="16.0" left="16.0" right="16.0" bottom="16.0"/></padding>
        </VBox>
    </ScrollPane>

</VBox>
