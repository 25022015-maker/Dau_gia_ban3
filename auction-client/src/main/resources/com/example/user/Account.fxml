<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #f4f6f9; -fx-background: #f4f6f9;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.AccountController">
    <content>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label text="TÀI KHOẢN CỦA TÔI" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- Profile card -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                <Label text="Thông tin tài khoản" style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #2c3e50;"/>
                <HBox spacing="20" style="-fx-padding: 10 0;">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Tên đăng nhập:" prefWidth="140" style="-fx-text-fill: #7f8c8d;"/>
                            <Label fx:id="lblUsername" text="—" style="-fx-font-weight: bold;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Email:" prefWidth="140" style="-fx-text-fill: #7f8c8d;"/>
                            <Label fx:id="lblEmail" text="—"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Vai trò:" prefWidth="140" style="-fx-text-fill: #7f8c8d;"/>
                            <Label fx:id="lblRole" text="—"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Trạng thái:" prefWidth="140" style="-fx-text-fill: #7f8c8d;"/>
                            <Label fx:id="lblStatus" text="ACTIVE" textFill="#27ae60"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Ngày tạo:" prefWidth="140" style="-fx-text-fill: #7f8c8d;"/>
                            <Label fx:id="lblCreatedAt" text="—"/>
                        </HBox>
                    </VBox>
                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 20;" prefWidth="200">
                        <Label text="SỐ DƯ TÀI KHOẢN" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
                        <Label fx:id="lblBalance" text="0 ₫" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Top-up card -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                <Label text="NẠP TIỀN VÀO TÀI KHOẢN" style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #2c3e50;"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="txtTopUpAmount" promptText="Nhập số tiền (₫)" prefWidth="250" prefHeight="38"
                               style="-fx-background-radius: 5;"/>
                    <Button text="Nạp tiền" onAction="#handleTopUp" prefHeight="38" prefWidth="120"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
                <Label fx:id="lblTopUpMessage" text="" wrapText="true"/>
            </VBox>

            <!-- Notifications -->
            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="THÔNG BÁO" style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="lblNotifCount" text="" style="-fx-text-fill: #7f8c8d;"/>
                </HBox>
                <ListView fx:id="listNotifications" prefHeight="200" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>