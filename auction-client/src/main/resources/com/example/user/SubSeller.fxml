<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="295.0" prefWidth="880.0" spacing="15.0" style="-fx-background-color: #F4ECF7; -fx-padding: 10;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SubSellerController">
    <children>
        <VBox prefWidth="220.0" spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 0);">
            <children>
                <Label text="QUAN SÁT PHÒNG THẦU" textFill="#8E44AD">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Label>

                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Trạng thái: ĐANG DIỄN RA" textFill="#27AE60" />

                        <Button fx:id="btnEndEarly" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEndEarly" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Chốt giá / Kết thúc sớm">
                            <padding><Insets bottom="8.0" top="8.0" /></padding>
                        </Button>

                        <Button fx:id="btnRequestCancel" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRequestCancel" style="-fx-background-color: #C0392B; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Yêu cầu hủy phiên">
                            <padding><Insets bottom="8.0" top="8.0" /></padding>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <children>
                <Label style="-fx-font-weight: bold;" text="👥 Danh sách người trong phòng thầu" textFill="#2C3E50" />
                <TableView fx:id="tableParticipants" style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="200.0" text="Tên người tham gia" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>
