<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="590.0" prefWidth="749.0"
      spacing="0"
      style="-fx-background-color: #1a1a2e;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.project.UI.Controller.Accountcontroller">

    <!-- ── Tab buttons ──────────────────────────────────────────────────── -->
    <HBox spacing="0" style="-fx-background-color: #16213e; -fx-border-color: #2d2d4e; -fx-border-width: 0 0 1 0;">
        <children>
            <Button fx:id="btnTabInfo"
                    text="👤  Thông tin"
                    onAction="#showTabInfo"
                    prefHeight="44.0" prefWidth="200.0"
                    style="-fx-background-color: #6c3483; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 0;"/>
            <Button fx:id="btnTabHistory"
                    text="📋  Lịch sử đấu giá"
                    onAction="#showTabHistory"
                    prefHeight="44.0" prefWidth="200.0"
                    style="-fx-background-color: #2d1b4e; -fx-text-fill: #c39bd3; -fx-font-size: 13px; -fx-background-radius: 0;"/>
            <Button fx:id="btnTabPassword"
                    text="🔒  Đổi mật khẩu"
                    onAction="#showTabPassword"
                    prefHeight="44.0" prefWidth="200.0"
                    style="-fx-background-color: #2d1b4e; -fx-text-fill: #c39bd3; -fx-font-size: 13px; -fx-background-radius: 0;"/>
        </children>
    </HBox>

    <!-- ── Tab 1: Thông tin cá nhân ────────────────────────────────────── -->
    <VBox fx:id="tabInfo" spacing="20.0" style="-fx-background-color: #1a1a2e;">
        <padding><Insets top="30.0" left="40.0" right="40.0" bottom="30.0"/></padding>
        <children>
            <Label text="Thông tin tài khoản"
                   style="-fx-text-fill: #f8f0ff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Separator style="-fx-background-color: #2d2d4e;"/>

            <!-- Avatar placeholder + tên -->
            <HBox spacing="20.0" style="-fx-alignment: CENTER_LEFT;">
                <VBox style="-fx-background-color: #6c3483; -fx-background-radius: 50;"
                      prefWidth="80.0" prefHeight="80.0"
                      alignment="CENTER">
                    <Label fx:id="lblAvatar" text="A"
                           style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label fx:id="lblUsername"
                           text="username"
                           style="-fx-text-fill: #f8f0ff; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblRole"
                           text="Bidder"
                           style="-fx-text-fill: #c39bd3; -fx-font-size: 13px;
                             -fx-background-color: #2d1b4e; -fx-padding: 3 10;
                             -fx-background-radius: 10;"/>
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #2d2d4e;"/>

            <!-- Thông tin chi tiết -->
            <HBox spacing="16.0" alignment="CENTER_LEFT">
                <Label text="Email:" style="-fx-text-fill: #7f8c9a; -fx-font-size: 14px; -fx-pref-width: 120;"/>
                <Label fx:id="lblEmail" text="—"
                       style="-fx-text-fill: #f8f0ff; -fx-font-size: 14px;"/>
            </HBox>
            <HBox spacing="16.0" alignment="CENTER_LEFT">
                <Label text="ID tài khoản:" style="-fx-text-fill: #7f8c9a; -fx-font-size: 14px; -fx-pref-width: 120;"/>
                <Label fx:id="lblId" text="—"
                       style="-fx-text-fill: #f8f0ff; -fx-font-size: 14px;"/>
            </HBox>
            <HBox spacing="16.0" alignment="CENTER_LEFT">
                <Label text="Trạng thái:" style="-fx-text-fill: #7f8c9a; -fx-font-size: 14px; -fx-pref-width: 120;"/>
                <Label text="🟢 Đang hoạt động"
                       style="-fx-text-fill: #2ecc71; -fx-font-size: 14px;"/>
            </HBox>
        </children>
    </VBox>

    <!-- ── Tab 2: Lịch sử đấu giá ──────────────────────────────────────── -->
    <VBox fx:id="tabHistory" spacing="16.0"
          style="-fx-background-color: #1a1a2e;"
          visible="false" managed="false">
        <padding><Insets top="30.0" left="40.0" right="40.0" bottom="30.0"/></padding>
        <children>
            <Label text="Lịch sử đấu giá"
                   style="-fx-text-fill: #f8f0ff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Separator style="-fx-background-color: #2d2d4e;"/>

            <Label text="Các phiên đấu giá bạn đã tham gia:"
                   style="-fx-text-fill: #7f8c9a; -fx-font-size: 13px;"/>

            <ListView fx:id="historyList"
                      prefHeight="380.0"
                      style="-fx-background-color: #16213e;
                          -fx-background-radius: 8;
                          -fx-border-color: #2d2d4e;
                          -fx-border-radius: 8;"/>
        </children>
    </VBox>

    <!-- ── Tab 3: Đổi mật khẩu ─────────────────────────────────────────── -->
    <VBox fx:id="tabPassword" spacing="20.0"
          style="-fx-background-color: #1a1a2e;"
          visible="false" managed="false">
        <padding><Insets top="30.0" left="40.0" right="40.0" bottom="30.0"/></padding>
        <children>
            <Label text="Đổi mật khẩu"
                   style="-fx-text-fill: #f8f0ff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Separator style="-fx-background-color: #2d2d4e;"/>

            <VBox spacing="8.0">
                <Label text="Mật khẩu hiện tại" style="-fx-text-fill: #c39bd3; -fx-font-size: 13px;"/>
                <PasswordField fx:id="txtCurrentPass"
                               promptText="Nhập mật khẩu hiện tại..."
                               prefHeight="38.0" prefWidth="360.0"
                               style="-fx-background-color: #16213e; -fx-text-fill: #f8f0ff;
                                  -fx-border-color: #2d2d4e; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-font-size: 14px;"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Mật khẩu mới" style="-fx-text-fill: #c39bd3; -fx-font-size: 13px;"/>
                <PasswordField fx:id="txtNewPass"
                               promptText="Nhập mật khẩu mới..."
                               prefHeight="38.0" prefWidth="360.0"
                               style="-fx-background-color: #16213e; -fx-text-fill: #f8f0ff;
                                  -fx-border-color: #2d2d4e; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-font-size: 14px;"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Xác nhận mật khẩu mới" style="-fx-text-fill: #c39bd3; -fx-font-size: 13px;"/>
                <PasswordField fx:id="txtConfirmPass"
                               promptText="Nhập lại mật khẩu mới..."
                               prefHeight="38.0" prefWidth="360.0"
                               style="-fx-background-color: #16213e; -fx-text-fill: #f8f0ff;
                                  -fx-border-color: #2d2d4e; -fx-border-radius: 6;
                                  -fx-background-radius: 6; -fx-font-size: 14px;"/>
            </VBox>

            <!-- Thông báo kết quả -->
            <Label fx:id="lblPassMessage" text=""
                   style="-fx-font-size: 13px;" visible="false" managed="false"/>

            <Button text="Đổi mật khẩu"
                    onAction="#handleChangePassword"
                    prefHeight="40.0" prefWidth="360.0"
                    style="-fx-background-color: #6c3483; -fx-text-fill: white;
                        -fx-font-size: 14px; -fx-background-radius: 6;
                        -fx-cursor: hand;"/>
        </children>
    </VBox>

</VBox>
