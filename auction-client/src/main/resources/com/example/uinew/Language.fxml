<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="590.0" prefWidth="749.0" spacing="0"
      style="-fx-background-color: #1a1a2e;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.project.UI.Controller.LanguageController">

    <!-- Header -->
    <HBox prefHeight="60.0" alignment="CENTER_LEFT"
          style="-fx-background-color: #16213e; -fx-border-color: #2d2d4e; -fx-border-width: 0 0 1 0;">
        <padding><Insets left="24.0"/></padding>
        <Label text="🌐  Ngôn ngữ"
               style="-fx-text-fill: #f8f0ff; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="20.0">
        <padding><Insets top="40.0" left="40.0" right="40.0"/></padding>

        <Label text="Chọn ngôn ngữ hiển thị"
               style="-fx-text-fill: #c39bd3; -fx-font-size: 14px;"/>

        <!-- Tiếng Việt -->
        <HBox fx:id="cardVI" spacing="16.0" alignment="CENTER_LEFT"
              onMouseClicked="#selectVietnamese"
              style="-fx-background-color: #16213e; -fx-background-radius: 10;
                   -fx-border-color: #6c3483; -fx-border-radius: 10; -fx-border-width: 2;
                   -fx-padding: 20; -fx-cursor: hand;">
            <Label text="🇻🇳" style="-fx-font-size: 32px;"/>
            <VBox spacing="4.0">
                <Label text="Tiếng Việt"
                       style="-fx-text-fill: #f8f0ff; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="Vietnamese"
                       style="-fx-text-fill: #7f8c9a; -fx-font-size: 13px;"/>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="checkVI" text="✅"
                   style="-fx-font-size: 20px;"/>
        </HBox>

        <!-- Tiếng Anh -->
        <HBox fx:id="cardEN" spacing="16.0" alignment="CENTER_LEFT"
              onMouseClicked="#selectEnglish"
              style="-fx-background-color: #16213e; -fx-background-radius: 10;
                   -fx-border-color: #2d2d4e; -fx-border-radius: 10; -fx-border-width: 2;
                   -fx-padding: 20; -fx-cursor: hand;">
            <Label text="🇬🇧" style="-fx-font-size: 32px;"/>
            <VBox spacing="4.0">
                <Label text="Tiếng Anh"
                       style="-fx-text-fill: #f8f0ff; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="English"
                       style="-fx-text-fill: #7f8c9a; -fx-font-size: 13px;"/>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="checkEN" text="✅"
                   style="-fx-font-size: 20px;" visible="false"/>
        </HBox>

        <Label fx:id="lblSaved" text=""
               style="-fx-text-fill: #2ecc71; -fx-font-size: 13px;"
               visible="false" managed="false"/>
    </VBox>
</VBox>
