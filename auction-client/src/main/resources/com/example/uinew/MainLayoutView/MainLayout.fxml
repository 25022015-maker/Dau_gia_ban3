<BorderPane stylesheets="@style.css" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="719.0" prefWidth="1018.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.uinew.Controller.HomeController">
   <top>
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefHeight="129.0" prefWidth="1018.0" style="-fx-background-image: url(&quot;img_5.png&quot;);" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#toggleSidebar" prefHeight="129.0" prefWidth="323.0" styleClass="btn-sidebar-main" text="Bidding With Kuro" HBox.hgrow="ALWAYS">
               <HBox.margin><Insets right="70.0" /></HBox.margin>
               <font><Font name="MilkywayDEMO" size="16.0" /></font>
               <textFill>
                  <LinearGradient endX="1.0" endY="1.0">
                     <stops>
                        <Stop><color><Color red="0.573" green="0.32" blue="1.0" /></color></Stop>
                        <Stop offset="1.0"><color><Color red="1.0" green="0.44" blue="0.873" /></color></Stop>
                     </stops>
                  </LinearGradient>
               </textFill>
               <cursor><Cursor fx:constant="HAND" /></cursor>
               <graphic>
                  <ImageView fitHeight="60.0" fitWidth="78.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../../../../img_4.png" /></image>
                  </ImageView>
               </graphic>
            </Button>

            <Button alignment="CENTER" styleClass="btn-outline" mnemonicParsing="false" prefHeight="41.0" prefWidth="127.0" text="Sản phẩm">
               <font><Font name="System Bold" size="14.0" /></font>
               <cursor><Cursor fx:constant="HAND" /></cursor>
               <HBox.margin><Insets left="20.0" right="30.0" /></HBox.margin>
               <effect><DropShadow blurType="ONE_PASS_BOX" /></effect>
            </Button>

            <Button alignment="CENTER" styleClass="btn-purple" mnemonicParsing="false" prefHeight="41.0" prefWidth="129.0" text="Thông báo">
               <HBox.margin><Insets right="30.0" /></HBox.margin>
               <font><Font name="System Bold" size="14.0" /></font>
               <cursor><Cursor fx:constant="HAND" /></cursor>
               <effect><DropShadow blurType="ONE_PASS_BOX" /></effect>
            </Button>

            <Pane prefHeight="129.0" prefWidth="109.0" HBox.hgrow="ALWAYS" />

            <Button alignment="CENTER" styleClass="btn-plus" mnemonicParsing="false" onAction="#createAuction" prefHeight="50.0" prefWidth="53.0" text="➕ " textFill="#f4d9ff">
               <HBox.margin><Insets right="20.0" /></HBox.margin>
               <cursor><Cursor fx:constant="HAND" /></cursor>
               <effect><DropShadow /></effect>
            </Button>
         </children>
      </HBox>
   </top>
   <left>
      <VBox fx:id="vboxSidebar" prefHeight="590.0" prefWidth="321.0" style="-fx-background-color: DCBFFF; -fx-background-image: url(&quot;img_5.png&quot;);" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#goToDashBoard" prefHeight="63.0" prefWidth="338.0" styleClass="btn-sidebar-item-light" text="Trang chủ" />
            <Button mnemonicParsing="false" prefHeight="63.0" prefWidth="333.0" styleClass="btn-sidebar-item-dark" text="Tài khoản" />
            <Button mnemonicParsing="false" onAction="#createAuction" prefHeight="63.0" prefWidth="342.0" styleClass="btn-sidebar-item-light" text="Hướng dẫn" />
            <Button mnemonicParsing="false" onAction="#onLogout" prefHeight="63.0" prefWidth="353.0" styleClass="btn-sidebar-item-dark" text="Đăng xuất" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" prefHeight="571.0" prefWidth="749.0" style="-fx-border-color: #FEA8FF; -fx-border-width: 10; -fx-border-style: dashed;" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>