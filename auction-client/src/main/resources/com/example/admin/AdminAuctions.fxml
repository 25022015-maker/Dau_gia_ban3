<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Quản lý danh sách đấu giá" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField prefWidth="250.0" promptText="Tìm kiếm phiên..." />
        </HBox>

        <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                <TableColumn fx:id="colName" prefWidth="200" text="Tên sản phẩm" />
                <TableColumn fx:id="colUser" prefWidth="120" text="Người đăng" />
                <TableColumn fx:id="colPrice" prefWidth="100" text="Giá hiện tại" />
                <TableColumn fx:id="colStatus" prefWidth="120" text="Trạng thái" />

                <TableColumn fx:id="colAction" prefWidth="150" text="Thao tác" />
            </columns>
        </TableView>

        <HBox spacing="10">
            <Button style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Phê duyệt" />

            <Button style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Hủy phiên" />
        </HBox>
    </children>
</VBox>
