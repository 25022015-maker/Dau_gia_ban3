<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="680.0" prefWidth="880.0" spacing="20" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controller.AdminUsersController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Quản lý người dùng hệ thống" />
            <Region HBox.hgrow="ALWAYS" xmlns:HBox="http://javafx.com/javafx/17.0.12"/>
            <Button onAction="#handleRefresh"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
                    text="🔄 Làm mới" />
        </HBox>

        <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </TableView>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>
