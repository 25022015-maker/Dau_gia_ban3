<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="680.0" prefWidth="880.0" spacing="20" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox prefHeight="39.0" prefWidth="623.0">
            <children>
                <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Quản lý người dùng hệ thống" />
            </children>
        </HBox>

        <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn prefWidth="58.0" text="ID" />
                <TableColumn prefWidth="150" text="Họ tên" />
                <TableColumn prefWidth="150" text="Email" />
                <TableColumn prefWidth="100" text="Số dư" />
                <TableColumn prefWidth="100" text="Vai trò" />
                <TableColumn prefWidth="120" text="Trạng thái" />
            </columns>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button mnemonicParsing="false" prefHeight="10.0" prefWidth="66.0" text="All" />
            <Pane prefHeight="25.0" prefWidth="13.0" />
            <Button mnemonicParsing="false" prefHeight="8.0" prefWidth="66.0" text="Upgrade" />
            <Pane prefHeight="25.0" prefWidth="563.0" />
            <Button style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Khóa tài khoản" />
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>
